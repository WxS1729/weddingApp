page {
    width: 100%;
    overflow-x: hidden;
    box-sizing: border-box;
    font-size: 26rpx;
    font-family: PingFangSC-Light;
    color: #fff;
    letter-spacing: 2rpx;
    margin: 0;
    padding: 0;
    background-color: #222;
  }

button {
  background-color: transparent;
}

button::after {
  border: none;
}

.button-hover {
  background-color: transparent !important;
}


.couple-cover {
    width: 268rpx;
    height: 426rpx;
}