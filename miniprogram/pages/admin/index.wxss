.admin-page {
    padding: 40rpx;
    min-height: 100vh;
    background-color: #fff;
}

.header {
    font-size: 40rpx;
    font-weight: bold;
    text-align: center;
    margin-bottom: 40rpx;
}

.loading {
    text-align: center;
    color: #999;
    margin-top: 200rpx;
}

.summary {
    display: flex;
    justify-content: space-around;
    margin-bottom: 40rpx;
    padding: 30rpx 0;
    background-color: #fef0f5;
    border-radius: 16rpx;
}

.summary-item {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.summary-value {
    font-size: 48rpx;
    font-weight: bold;
    color: #ff368d;
}

.summary-label {
    font-size: 24rpx;
    color: #999;
    margin-top: 8rpx;
}

.list-header {
    font-size: 28rpx;
    color: #999;
    margin-bottom: 20rpx;
    padding-left: 10rpx;
}

.list {
    border-top: 1rpx solid #eee;
}

.list-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24rpx 10rpx;
    border-bottom: 1rpx solid #eee;
}

.item-name {
    font-size: 30rpx;
    color: #333;
}

.item-num {
    font-size: 28rpx;
    color: #ff368d;
    font-weight: 600;
}

.empty {
    text-align: center;
    color: #ccc;
    margin-top: 200rpx;
    font-size: 28rpx;
}
